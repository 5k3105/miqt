# Offload build env — Debian 13 + native Clang 18 + aqtinstall Qt 6.11 + KF6 built from source.
# 5k3105 hub: IW-098 (KSyntaxHighlighting) / IW-102 (KWidgetsAddons) / WN-053.
#
# THE CLEAN, COMPLETE recipe. Every Arch attempt failed on the clang environment: Arch's Clang 22
# breaks nested-enum generation, and a prebuilt Clang 18 on Arch gives degraded parses. The
# maintainer's proven-clean combo is v0.14.0 + native Clang 18 + Qt 6.11 (their Dockerfile uses
# Debian 13 + aqtinstall). We replicate that AND add the KF6 they don't ship — built from source
# against the SAME aqt Qt 6.11, so Qt / KF6 / toolchain are all consistent.
FROM debian:13

# KF6 framework tag to build. v6.26.0 = the version the Deck runs with Qt 6.11 (so the bindings
# match the runtime), and recent enough to build cleanly against Qt 6.11 (older tags like v6.10.0
# define their own operator""_sv which now collides with Qt 6.11's native one).
ARG KF_VER=v6.26.0
ENV DEBIAN_FRONTEND=noninteractive

# Base toolchain + build deps + Qt runtime libs (for aqt's Qt to load).
RUN apt-get update && apt-get install -qyy \
      build-essential git wget curl ca-certificates pkg-config gnupg lsb-release \
      cmake ninja-build python3-pip python3-venv \
      libgl1 libglx0 libegl1 libfontconfig1 libfreetype6 libglib2.0-0t64 libxkbcommon0 libdbus-1-3 \
      `# -dev libs that aqt's Qt6Gui cmake config requires when find_package'd (WrapOpenGL etc.):` \
      libgl1-mesa-dev libglvnd-dev mesa-common-dev libvulkan-dev libxkbcommon-dev \
  && apt-get clean

# Native Clang 18 from apt.llvm.org (finds Debian's libstdc++ correctly — the thing a prebuilt
# clang on Arch could not). Symlink to `clang` so genbindings can use `-clang clang`.
RUN wget -O /tmp/llvm.sh https://apt.llvm.org/llvm.sh && chmod +x /tmp/llvm.sh && /tmp/llvm.sh 18 \
  && ln -sf /usr/bin/clang-18 /usr/local/bin/clang \
  && clang --version | head -1

# Go (the repo's go.mod needs 1.26).
RUN wget -q https://go.dev/dl/go1.26.3.linux-amd64.tar.gz -O /tmp/go.tgz \
  && tar -C /usr/local -xzf /tmp/go.tgz && rm /tmp/go.tgz
ENV PATH=/usr/local/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Also put Go on the PATH for login shells (bash -lc re-sources /etc/profile, which would
# otherwise reset PATH and drop /usr/local/go/bin).
RUN echo 'export PATH=$PATH:/usr/local/go/bin' > /etc/profile.d/go.sh

# Qt 6.11.1 via aqtinstall → /6.11.1/gcc_64 (the maintainer's exact method).
RUN python3 -m venv /aqt && /aqt/bin/pip3 install aqtinstall \
  && /aqt/bin/aqt install-qt linux desktop 6.11.1 linux_gcc_64 -O / \
  && rm -rf /root/.cache
ENV PKG_CONFIG_PATH=/6.11.1/gcc_64/lib/pkgconfig
ENV CMAKE_PREFIX_PATH=/6.11.1/gcc_64
ENV LD_LIBRARY_PATH=/6.11.1/gcc_64/lib

# KF6 built from source against aqt's Qt 6.11, installed into /usr (so /usr/include/KF6 resolves).
# extra-cmake-modules first (build dep), then the two frameworks we bind.
RUN git clone --depth 1 -b $KF_VER https://invent.kde.org/frameworks/extra-cmake-modules.git /tmp/ecm \
  && cmake -S /tmp/ecm -B /tmp/ecm/b -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DBUILD_TESTING=OFF \
  && cmake --build /tmp/ecm/b && cmake --install /tmp/ecm/b && rm -rf /tmp/ecm
# -DBUILD_PYTHON_BINDINGS=OFF: KF6 frameworks try find_package(Shiboken6) (Qt-for-Python) for
# their Python bindings, which we don't want and isn't installed. We only need the C++ libs/headers.
RUN git clone --depth 1 -b $KF_VER https://invent.kde.org/frameworks/syntax-highlighting.git /tmp/ksh \
  && cmake -S /tmp/ksh -B /tmp/ksh/b -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DBUILD_TESTING=OFF -DBUILD_PYTHON_BINDINGS=OFF \
  && cmake --build /tmp/ksh/b && cmake --install /tmp/ksh/b && rm -rf /tmp/ksh
RUN git clone --depth 1 -b $KF_VER https://invent.kde.org/frameworks/kwidgetsaddons.git /tmp/kwa \
  && cmake -S /tmp/kwa -B /tmp/kwa/b -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DBUILD_TESTING=OFF -DBUILD_PYTHON_BINDINGS=OFF \
  && cmake --build /tmp/kwa/b && cmake --install /tmp/kwa/b && rm -rf /tmp/kwa

# genbindings' config uses Debian multiarch qt6 paths; aqt installs to /6.11.1/gcc_64 — symlink so
# the qt6 generate() srcDirs resolve. (Qt5 + uninstalled submodules skipped by the patched generator.)
RUN mkdir -p /usr/include/x86_64-linux-gnu \
  && ln -sf /6.11.1/gcc_64/include /usr/include/x86_64-linux-gnu/qt6

ENV CGO_ENABLED=1
WORKDIR /work

# Fail-fast sanity: Qt pkg-config resolves, and the KF6 headers landed where the config expects.
RUN pkg-config --exists Qt6Widgets && echo "Qt6Widgets: $(pkg-config --modversion Qt6Widgets)" \
  && test -f /usr/include/KF6/KSyntaxHighlighting/KSyntaxHighlighting/repository.h \
  && test -f /usr/include/KF6/KWidgetsAddons/kmessagewidget.h \
  && echo "env OK: Qt 6.11 (aqt) + KF6 (source, $KF_VER) + clang-18"
